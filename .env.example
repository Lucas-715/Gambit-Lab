# =====================================================================
# GAMBIT LAB 2.1 (NOCTURNE) — Configurações de Ambiente
# NENHUMA CHAVE REAL DEVE SER COMMITADA NESTE ARQUIVO OU NO REPOSITÓRIO
# =====================================================================

# Ambiente de execução (development | test | production)
ENVIRONMENT=development

# Configuração da API FastAPI
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Chave da API do Google Gemini (Opcional para modo DEMO_OFFLINE)
# Se omitida ou se GAMBIT_FORCE_DEMO=1, a plataforma roda em DEMO_OFFLINE explicitamente rotulado
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GAMBIT_FORCE_DEMO=0

# Pesquisa Web Pública Auditável (Wikimedia / OpenAlex HTTPS + Anti-SSRF)
GAMBIT_WEB_SEARCH_ENABLED=1

# Diretório de persistência de dados (sessões, eventos e uploads)
STORAGE_DIR=./data/storage
DATABASE_URL=sqlite:///./data/gambit_lab.db

# Políticas de fontes (OWN_ONLY | WEB_ONLY | HYBRID) e limites de segurança
SOURCE_POLICY_DEFAULT=OWN_ONLY
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=["application/pdf","text/plain","text/markdown"]
SSRF_PROTECTION_ENABLED=true

# Limites orçamentários por sessão
MAX_BRANCHES_PER_SESSION=3
MAX_TURNS_PER_BRANCH=20
MAX_INVESTIGATION_STEPS_DEFAULT=12
MAX_TOKENS_PER_SESSION=50000
MAX_GEMINI_CALLS_PER_SESSION=20

